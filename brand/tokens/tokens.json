{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Nightport",
  "version": "0.1.0",
  "color": {
    "palette": {
      "midnight":  { "$type": "color", "$value": "#0B0D1A", "$description": "Fondo principal. La noche: calma." },
      "harbor":    { "$type": "color", "$value": "#151833", "$description": "Superficies, tarjetas, barra lateral." },
      "harborHi":  { "$type": "color", "$value": "#1B1E3A", "$description": "Superficie interior (inputs, filas activas)." },
      "dusk":      { "$type": "color", "$value": "#24284A", "$description": "Elevación, hover, chips." },
      "line":      { "$type": "color", "$value": "#2A2F57", "$description": "Bordes sutiles." },
      "portal":    { "$type": "color", "$value": "#7C6CFF", "$description": "Primario: confianza, marca, selección." },
      "portalSoft":{ "$type": "color", "$value": "#A99FFF", "$description": "Enlaces e íconos activos sobre fondo oscuro." },
      "portalDeep":{ "$type": "color", "$value": "#5B48E8", "$description": "Portal sobre fondos claros; texto blanco encima (5.9:1)." },
      "tide":      { "$type": "color", "$value": "#3DDBD0", "$description": "Apoyo: funciona, progreso, éxito." },
      "tideDeep":  { "$type": "color", "$value": "#0E9C93", "$description": "Tide sobre fondos claros." },
      "ember":     { "$type": "color", "$value": "#FF7A45", "$description": "Energía: solo Jugar y acciones clave." },
      "emberDeep": { "$type": "color", "$value": "#E85A22", "$description": "Ember sobre fondos claros." },
      "moonlight": { "$type": "color", "$value": "#EEF0FF", "$description": "Texto principal (17:1 sobre midnight)." },
      "mist":      { "$type": "color", "$value": "#9AA0C3", "$description": "Texto secundario (7.5:1 sobre midnight)." }
    },
    "semantic": {
      "background":     { "$type": "color", "$value": "{color.palette.midnight}" },
      "surface":        { "$type": "color", "$value": "{color.palette.harbor}" },
      "surfaceInset":   { "$type": "color", "$value": "{color.palette.harborHi}" },
      "elevated":       { "$type": "color", "$value": "{color.palette.dusk}" },
      "border":         { "$type": "color", "$value": "{color.palette.line}" },
      "textPrimary":    { "$type": "color", "$value": "{color.palette.moonlight}" },
      "textSecondary":  { "$type": "color", "$value": "{color.palette.mist}" },
      "accentPrimary":  { "$type": "color", "$value": "{color.palette.portal}" },
      "accentSupport":  { "$type": "color", "$value": "{color.palette.tide}" },
      "accentEnergy":   { "$type": "color", "$value": "{color.palette.ember}" },
      "onAccent":       { "$type": "color", "$value": "{color.palette.midnight}", "$description": "Texto sobre portal (5.0:1), tide (11.3:1) y ember (7.5:1)." }
    },
    "compat": {
      "excelente":  { "bg": "#3DDBD0", "fg": "#0B0D1A", "border": "#3DDBD0", "profileStatus": ["verificado", "funciona"] },
      "jugable":    { "bg": "#7C6CFF", "fg": "#0B0D1A", "border": "#7C6CFF", "profileStatus": ["jugable"] },
      "enPruebas":  { "bg": "transparent", "fg": "#FF7A45", "border": "#FF7A45", "profileStatus": ["probando", "smoke-test"] },
      "sinProbar":  { "bg": "transparent", "fg": "#9AA0C3", "border": "#2A2F57", "profileStatus": ["pendiente"] },
      "bloqueado":  { "bg": "transparent", "fg": "#9AA0C3", "border": "#9AA0C3", "profileStatus": ["bloqueado"], "$description": "Anti-cheat sin soporte. Mostrar con ícono de candado." }
    }
  },
  "font": {
    "display": { "family": "Unbounded",      "postscript": { "500": "Unbounded-Medium", "600": "Unbounded-SemiBold", "700": "Unbounded-Bold" }, "letterSpacingEm": -0.02 },
    "ui":      { "family": "Manrope",        "postscript": { "400": "Manrope-Regular", "500": "Manrope-Medium", "600": "Manrope-SemiBold", "700": "Manrope-Bold", "800": "Manrope-ExtraBold" } },
    "mono":    { "family": "JetBrains Mono", "postscript": { "400": "JetBrainsMono-Regular", "500": "JetBrainsMono-Medium" } }
  },
  "typeScale": {
    "displayXL": { "font": "display", "weight": 600, "size": 44, "lineHeight": 1.12 },
    "title":     { "font": "display", "weight": 600, "size": 28, "lineHeight": 1.2 },
    "heading":   { "font": "ui", "weight": 800, "size": 22 },
    "rowTitle":  { "font": "ui", "weight": 700, "size": 15 },
    "body":      { "font": "ui", "weight": 500, "size": 15, "lineHeight": 1.55 },
    "caption":   { "font": "ui", "weight": 500, "size": 13 },
    "overline":  { "font": "mono", "weight": 500, "size": 12, "letterSpacingEm": 0.08, "uppercase": true },
    "metric":    { "font": "mono", "weight": 400, "size": 26 }
  },
  "radius": { "chip": 14, "control": 12, "card": 20, "panel": 24, "hero": 28, "appIcon": "185/1024" },
  "space": { "xxs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 24, "xl": 32, "xxl": 48 },
  "size": { "minTarget": 44, "sidebarWidth": 232, "playButtonHeight": 52 }
}
