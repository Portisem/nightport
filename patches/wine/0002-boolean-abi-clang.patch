diff -ruN a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
--- a/dlls/ntdll/unix/unix_private.h	2026-10-10 17:58:14
+++ b/dlls/ntdll/unix/unix_private.h	2026-10-10 17:58:14
@@ -733,4 +733,16 @@
 
 #endif  /* defined(__i386__) || defined(__x86_64__) */
 
+
+/* GamingMac: Apple clang assumes narrow (BOOLEAN) arguments arrive zero-extended to 32 bits
+ * (Darwin x86-64 convention), but Windows callers only set the low byte; e.g. Steam passes
+ * restart=FALSE to NtQueryDirectoryObject with garbage in the upper bits, which clang then
+ * reads as TRUE and loops forever. The empty asm hides the value so the mask is really applied. */
+static inline BOOLEAN gm_bool( BOOLEAN b )
+{
+    unsigned int v = b;
+    __asm__ __volatile__( "" : "+r" (v) );
+    return (v & 0xff) != 0;
+}
+
 #endif /* __NTDLL_UNIX_PRIVATE_H */
